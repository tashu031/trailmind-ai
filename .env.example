# ==============================================================================
# TrailMind AI — Environment Variables Configuration
# "Plan less. Explore more. AI should help you leave the screen."
# ==============================================================================

# Application Environment
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. LOCAL AI CONFIGURATION (Default & Recommended)
# ------------------------------------------------------------------------------
# Gemma open-weight models run locally via Ollama with zero cloud leakage.
# Install Ollama from https://ollama.com and run: `ollama run gemma2:2b`
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma2:2b
GEMMA_VISION_MODEL=paligemma
AI_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 2. OPTIONAL CLOUD PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Set CLOUD_AI_PROVIDER to "none" (default), "openai_compatible", or "huggingface"
CLOUD_AI_PROVIDER=none
CLOUD_AI_API_KEY=
CLOUD_AI_BASE_URL=https://api.openai.com/v1
CLOUD_AI_MODEL=google/gemma-2-9b-it

# ------------------------------------------------------------------------------
# 3. OPTIONAL CLOUD PERSISTENCE (MongoDB Atlas)
# ------------------------------------------------------------------------------
# If left blank, TrailMind operates in local-first mode using IndexedDB and in-memory store.
MONGODB_URI=
MONGODB_DB_NAME=trailmind_db

# ------------------------------------------------------------------------------
# 4. OPTIONAL MONITORING (Sentry)
# ------------------------------------------------------------------------------
# Used for telemetry traces around generateMission, analyzeObservation, generateJournal
SENTRY_DSN=

# ------------------------------------------------------------------------------
# 5. OPTIONAL VOICE NARRATION (ElevenLabs)
# ------------------------------------------------------------------------------
# If left blank, TrailMind uses browser Web Speech synthesis automatically.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
